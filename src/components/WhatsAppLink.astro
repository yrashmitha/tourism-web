---
import { whatsappUrl, type Language } from '../data/site';
const { lang = 'ja', label, message, class: className = 'button button-red' } = Astro.props as { lang?: Language; label: string; message?: string; class?: string };
---
<a class={className} href={whatsappUrl(lang, message)} target="_blank" rel="noreferrer">
  <svg class="whatsapp-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 11.7a8.1 8.1 0 0 1-8.2 8.1 8.5 8.5 0 0 1-3.8-.9l-4.1 1.1 1.1-4a8.3 8.3 0 1 1 15-4.3Z"/><path d="M8.5 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.3 0 .5-.1.7l-.5.6c-.2.2-.2.4-.1.6.3.6.8 1.1 1.4 1.5.3.2 1 .6 1.6.8.2.1.4 0 .6-.2l.7-.8c.2-.2.4-.3.7-.2l1.6.8c.3.1.4.3.4.5 0 .3-.2 1.2-.8 1.7-.6.6-1.3.7-1.8.7-.6 0-1.5-.2-2.8-.8-1.7-.8-3-2.3-3.4-2.8-.4-.5-1.1-1.5-1.1-2.7 0-1.1.6-1.8.8-2.1Z"/></svg>{label}<span aria-hidden="true">→</span>
