---
import '../styles/atlas-rail.css';
import WhatsAppLink from './WhatsAppLink.astro';
import { copy, pagePath, type Language } from '../data/site';
import atlasField from '../../assets/plates/atlas-field-plate.png?url';
import coastPhoto from '../../assets/plates/coast-photo.png?url';
import highlandsPhoto from '../../assets/plates/highlands-photo.png?url';
import heritagePhoto from '../../assets/plates/heritage-photo.png?url';
import durationScenery from '../../assets/plates/duration-scenery.png?url';
import coastPeek from '../../assets/plates/next-feature-coast.png?url';
import highlandsPeek from '../../assets/plates/next-feature-highlands.png?url';
import heritagePeek from '../../assets/plates/next-feature-heritage.png?url';

const { lang = 'ja' } = Astro.props as { lang?: Language };
const t = copy[lang];
const packages = pagePath(lang, 'packages');
const destinations = [
  { id: 'coast', image: coastPhoto, alt: lang === 'ja' ? '南海岸の岩とココナツの木' : 'Palm-lined beach and granite shoreline on Sri Lanka’s south coast', theme: t.regions[0] },
  { id: 'highlands', image: highlandsPhoto, alt: lang === 'ja' ? '茶畑とナインアーチブリッジを走る青い列車' : 'Blue train crossing the Nine Arch Bridge in Sri Lanka’s green highlands', theme: t.regions[1] },
  { id: 'heritage', image: heritagePhoto, alt: lang === 'ja' ? '夕暮れのシーギリヤ・ロック' : 'Sigiriya rock above the central plains at sunset', theme: t.regions[2] },
];
const places = [
  { en: 'Jaffna', ja: 'ジャフナ', x: 67.1, y: 4.8, align: 'left' },
  { en: 'Anuradhapura', ja: 'アヌラーダプラ', x: 63.2, y: 27.1, align: 'center' },
  { en: 'Trincomalee', ja: 'トリンコマリー', x: 83.1, y: 28.7, align: 'left' },
  { en: 'Sigiriya', ja: 'シーギリヤ', x: 72.5, y: 43.5, align: 'left' },
  { en: 'Kandy', ja: 'キャンディ', x: 72.6, y: 53.2, align: 'left' },
  { en: 'Colombo', ja: 'コロンボ', x: 54.2, y: 60.7, align: 'right' },
  { en: 'Ella', ja: 'エッラ', x: 87.5, y: 62.2, align: 'left' },
  { en: 'Galle', ja: 'ゴール', x: 64.2, y: 75.2, align: 'right' },
  { en: 'Mirissa', ja: 'ミリッサ', x: 72.4, y: 83.8, align: 'left' },
];
const durations = lang === 'ja'
  ? [{ days: '1日', route: '気軽に出会う' }, { days: '2日', route: '海と高原へ' }, { days: '4日', route: '文化と自然をめぐる' }, { days: '6日', route: '島をくるりと旅する' }]
  : [{ days: '1 day', route: 'A first taste' }, { days: '2 days', route: 'Coast to highlands' }, { days: '4 days', route: 'Culture & nature' }, { days: '6 days', route: 'Across the island' }];
const teasers = [
  { image: coastPeek, alt: lang === 'ja' ? '南海岸の青い海とココナツの木' : 'Coconut palms above the southern coast', name: t.regions[0].en },
  { image: highlandsPeek, alt: lang === 'ja' ? '高原の茶畑と青い列車' : 'Tea country and a blue train in the highlands', name: t.regions[1].en },
  { image: heritagePhoto, alt: lang === 'ja' ? '夕日に染まるシーギリヤ' : 'Sigiriya in the late-afternoon light', name: t.regions[2].en },
];
---
<section class="atlas-home" aria-label={lang === 'ja' ? 'スリランカの旅を地図から' : 'Sri Lanka journeys, connected by a map'}>
  <div class="atlas-opening">
    <div class="atlas-map-field" data-route-motion>
      <div class="atlas-copy">
        <h1>{t.heroJa}</h1>
        <p class="atlas-english-title">{t.heroEn}</p>
        <p class="atlas-introduction">{t.intro}</p>
        <p class="atlas-guide-note">{t.guideNote}</p>
        <div class="atlas-actions">
          <WhatsAppLink lang={lang} label={t.whatsapp} class="button button-red atlas-whatsapp" />
          <a class="button button-outline atlas-packages" href={packages}>{t.packagesLink}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="atlas-map-art">
        <img class="atlas-field-plate" src={atlasField} alt="" fetchpriority="high" />
        <div class="atlas-annotations" role="img" aria-label={lang === 'ja' ? '北のジャフナからコロンボ、キャンディ、エッラ、ゴール、ミリッサをつなぐ、旅のイメージを示したスリランカ地図' : 'Illustrative Sri Lanka route linking Jaffna, Colombo, Kandy, Ella, Galle and Mirissa'}>
          <svg class="atlas-route" viewBox="0 0 1081 789" preserveAspectRatio="none" aria-hidden="true">
            <path class="route-underlay" d="M707 42 C716 70 725 96 732 122 C740 153 738 180 721 203 C713 215 704 226 700 239 C694 265 729 275 765 269 C809 262 855 245 888 231 C902 255 900 292 909 327 C922 372 931 423 930 475 C913 486 879 491 846 485 C817 480 796 452 786 418 C779 390 779 365 786 344 C776 377 780 399 785 417 C746 423 690 445 662 469 C647 480 632 477 619 467 C636 510 667 550 698 581 C723 607 750 627 779 642" />
            <path class="route-line" pathLength="1" d="M707 42 C716 70 725 96 732 122 C740 153 738 180 721 203 C713 215 704 226 700 239 C694 265 729 275 765 269 C809 262 855 245 888 231 C902 255 900 292 909 327 C922 372 931 423 930 475 C913 486 879 491 846 485 C817 480 796 452 786 418 C779 390 779 365 786 344 C776 377 780 399 785 417 C746 423 690 445 662 469 C647 480 632 477 619 467 C636 510 667 550 698 581 C723 607 750 627 779 642" />
            {[ [707,42], [700,239], [888,231], [786,344], [785,417], [619,467], [930,475], [698,581], [779,642] ].map(([x,y], index) => (
              <g class={`route-stop route-stop--${index + 1}`}><circle class="stop-halo" cx={x} cy={y} r="10" /><circle class="stop-core" cx={x} cy={y} r="5" /></g>
            ))}
          </svg>
          <span class="country-name">{lang === 'ja' ? 'スリランカ' : 'SRI LANKA'}</span>
          <span class="sea-label sea-label--west">Indian<br />Ocean<small>インド洋</small></span>
          <span class="sea-label sea-label--east">Bay of<br />Bengal<small>ベンガル湾</small></span>
          {places.map((place) => (
            <span class={`map-place map-place--${place.align}`} style={`--map-x:${place.x}%;--map-y:${place.y}%`}>
              <span>{place.en}</span><small>{place.ja}</small>
            </span>
          ))}
          <div class="map-compass" aria-hidden="true">
            <span class="compass-n">N</span><span class="compass-e">E</span><span class="compass-s">S</span><span class="compass-w">W</span>
            <svg viewBox="0 0 80 80"><path d="M40 5 47 34 75 40 47 46 40 75 33 46 5 40 33 34Z"/><path d="m40 17 4 23-4 23-4-23Z"/><circle cx="40" cy="40" r="3"/></svg>
          </div>
          <div class="map-scale" aria-hidden="true"><span>0</span><span>50</span><span>100 km</span><i></i></div>
        </div>
      </div>

    </div>

    <aside class="destination-index" aria-label={lang === 'ja' ? '旅のテーマ' : 'Journey themes'}>
      {destinations.map((destination) => (
        <article class="destination-panel">
          <a class="destination-photo" href={packages} aria-label={`${destination.theme.en} — ${lang === 'ja' ? '旅のパッケージを見る' : 'explore journey ideas'}`}>
            <img src={destination.image} alt={destination.alt} loading="eager" />
          </a>
          <div class="destination-caption">
            <div>
              <h2><span>{destination.theme.en}</span><em>{destination.theme.ja}</em></h2>
              <p>{destination.theme.text}</p>
            </div>
            <a class="destination-arrow" href={packages} aria-label={`${destination.theme.en} — ${lang === 'ja' ? '旅のパッケージを見る' : 'explore journey ideas'}`}><span aria-hidden="true">›</span></a>
          </div>
        </article>
      ))}
    </aside>
  </div>

  <div class="duration-rail" aria-label={lang === 'ja' ? '旅の日数のアイデア' : 'Illustrative journey lengths'}>
    <div class="duration-heading"><h2>{lang === 'ja' ? '旅の長さから、' : 'Choose a pace,'}<br />{lang === 'ja' ? 'ルートを描く' : 'then find your route'}</h2><small>{lang === 'ja' ? '旅の日数のイメージ' : 'ILLUSTRATIVE LENGTHS'}</small></div>
    <img class="duration-scenery" src={durationScenery} alt="" loading="lazy" />
    <ol class="duration-stops">
      {durations.map((duration) => <li><a href={packages}><strong>{duration.days}</strong><span>{duration.route}</span></a></li>)}
    </ol>
    <a class="duration-more" href={packages}>{t.packagesLink}<span aria-hidden="true">→</span></a>
  </div>

  <section class="featured-peek" aria-labelledby="featured-peek-title">
    <div class="featured-peek-heading"><h2 id="featured-peek-title">{t.packagesHeading}</h2><small>{t.packagesEn}</small></div>
    <div class="featured-peek-items">
      {teasers.map((item) => <a href={packages} class="featured-peek-item"><img src={item.image} alt={item.alt} loading="lazy" /><span>{item.name}</span></a>)}
    </div>
  </section>
  <section class="island-gallery" aria-labelledby="island-gallery-title">
    <div class="island-gallery-copy">
      <h2 id="island-gallery-title">{lang === 'ja' ? '島の風景を、\nもう少し。' : 'A little more of\nthe island.'}</h2>
      <p>{lang === 'ja' ? '茶畑の道から、野生動物が暮らす大地まで。スリランカの風景を旅のイメージとしてご紹介します。' : 'From winding roads through tea country to the landscapes of Sri Lanka’s wildlife. These scenes are illustrative travel imagery.'}</p>
    </div>
    <figure class="island-gallery-photo island-gallery-photo--road">
      <img src="/images/journey-road.webp" alt={lang === 'ja' ? '朝もやの光に包まれたスリランカ高原の茶畑と曲がりくねる道' : 'A winding road through Sri Lankan tea country in the morning light'} loading="lazy" />
      <figcaption>{lang === 'ja' ? '高原を走る道' : 'A road through the highlands'}</figcaption>
    </figure>
    <figure class="island-gallery-photo island-gallery-photo--safari">
      <img src="/images/yala-safari.webp" alt={lang === 'ja' ? '夕暮れの草原で野生の象を眺めるサファリのイメージ' : 'An illustrative safari scene with a wild elephant at sunset'} loading="lazy" />
      <figcaption>{lang === 'ja' ? '野生動物に出会う風景' : 'Wildlife at dusk'}</figcaption>
    </figure>
  </section>
  <p class="atlas-disclaimer">{t.disclaimer}</p>
</section>
